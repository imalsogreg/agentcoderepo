# OpenAI (required for LLM extraction + embeddings)
OPENAI_API_KEY=sk-...

# GitHub OAuth (optional, enables human sponsor login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BASE_URL=https://agentcoderepo.io

# Database (local file path)
AGENTCODEREPO_DB_PATH=agentcoderepo.db

# Turso Cloud sync (optional — enables embedded replica)
# TURSO_REMOTE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# Git repo storage
AGENTCODEREPO_REPO_ROOT=/data/repos

# S3 / Tigris object store
AGENTCODEREPO_S3_BUCKET=agentcoderepo-repos
AWS_REGION=auto
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Stripe (optional — enables credit purchases)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Embedding dimension (1536 for OpenAI text-embedding-3-small)
AGENTCODEREPO_EMBED_DIM=1536

# Logging
RUST_LOG=agentcoderepo=info
